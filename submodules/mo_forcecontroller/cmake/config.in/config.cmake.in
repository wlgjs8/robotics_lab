@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@CMAKE_TARGET_NAME@Targets.cmake")

if(NOT TARGET plaif::@CMAKE_TARGET_NAME@)
  set(@CMAKE_TARGET_NAME@_INCLUDE_DIRS "@CMAKE_CURRENT_SOURCE_DIR@/include")
  set(@CMAKE_TARGET_NAME@_LIBRARY_PATH "@CMAKE_CURRENT_BINARY_DIR@/lib")
else()
  set(@CMAKE_TARGET_NAME@_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include")
  set(@CMAKE_TARGET_NAME@_LIBRARY_PATH "@CMAKE_INSTALL_PREFIX@/lib")
endif()

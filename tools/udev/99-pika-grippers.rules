# LEGACY fixed-port names for direct Pika Gripper diagnostics.
#
# Both grippers are CH340 USB-serial chips (1a86:7522) with NO serial number,
# so they are indistinguishable by ID_SERIAL. These rules pin arm names to the
# current physical socket and therefore become stale whenever a module moves.
#
# The main `make run` stack DOES NOT use these symlinks. gripper_server resolves
# the left/right D405 serials from camera.health and pairs each camera with the
# CH340 on the same xHCI root port. Do not update/install this file for normal
# stack operation; retain it only for explicit legacy/manual port diagnostics.
#
# Mapping recaptured 2026-07-29 on the RTX 5090 control PC after the
# camera/gripper hub cable was reconnected to a different host port. The left
# gripper path is unchanged; the right gripper moved from 9-1.4 to 3-2.1.4:
#   USB port 3-1.1.4 -> left  gripper
#   USB port 3-2.1.4 -> right gripper
# VERIFY before trusting:  python3 scripts/umi_gripper_follow.py --ident left
# If a gripper moves to a different socket, update the KERNELS value below.
# Find it with `udevadm info -a -n /dev/ttyUSB0`; use the USB device KERNELS
# value next to idVendor/idProduct, not the interface suffix ending in `:1.0`.
#
# Install:  see tools/udev/install_pika_udev.sh

SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7522", KERNELS=="3-1.1.4",   SYMLINK+="pika-left",  GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7522", KERNELS=="3-2.1.4",   SYMLINK+="pika-right", GROUP="dialout", MODE="0660"

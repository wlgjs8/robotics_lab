# plans.yaml — robotics_lab 의 controller-manager 플랜 라이브러리 (named-plan service / cockpit).
#
# 왜 여기 있나. 서브모듈의 cockpit/plans/examples.yaml 은 문법 예시일 뿐이고 그 파일 스스로
# "shipped with the cockpit bundle and OVERWRITTEN on upgrade" 라고 밝힌다. 업스트림이 정한
# 작업용 라이브러리 위치는 <ws>/plans/ 인데 그건 서브모듈 트리 안이라 우리 저장소가 추적하지
# 못한다. planlib 의 해석 순서 1순위가 환경변수 CONTROL_MANAGER_PLANS_FILE 이므로
# (planlib.py:298-313), 파일은 우리 저장소에 두고 run_cm_stack.sh 가 그 변수를 export 한다.
# 서브모듈 수정 없음, pull 로 덮여쓰이지 않음, cockpit 과 ./plan CLI 가 같은 파일을 본다.
#
# 문법 권위: submodules/controller-manager/cockpit/PLANS_GUIDE.md
# 오프라인 검증: cockpit/plans/plan --dry-run --file cm_bridge/config/plans.yaml init
monkey:

  # 에피소드 리셋 포즈. 값 출처는 rb_gui 가 init motion 으로 캐싱해 둔
  # ~/.rb_servo_gui/init_motion.json (app.py:_init_motion_path / _save_init_joints) 이고,
  # 단위는 DEGREE 다 — 레거시 명령 wire 의 q_target_deg 와 같은 수이며, cm_bridge 의
  # ResetIngress 가 UDP 50256 JointTarget 을 CM Move(MOVJ) 로 넘길 때 쓰는 값과 동일하다
  # (Move waypoint 은 degree, SILS 검증 2026-08-16 — 단 STATE 토픽은 radian).
  #
  # 그래서 이 플랜과 정책 러너의 리셋은 같은 포즈로 수렴한다. 둘 중 하나를 바꾸면
  # 나머지도 같이 바꿔야 한다: 이 파일과 init_motion.json 은 한 값의 두 사본이다.
  # velocity_pct 20 도 브릿지의 리셋 MOVJ 기본값(cm_bridge_node.py _send_movj)과 맞춘 것이다.
  init:
  - left:
      movj:
        points:
          - joints: [ 233.880,   48.866,  123.058,  -66.600, -111.416, -130.232]
            velocity_pct: 20
    right:
      movj:
        points:
          - joints: [-236.341,  -43.550, -128.163,   64.013,  108.294,  131.645]
            velocity_pct: 20
    sync_phase: [left, right]

     }
+    // ---- schema 4 (2026-08-18): the stream follower, the overlay deviation, the external values.
+    // The monotonic cycle stamp is the SAME clock rt::now_ns gives every process on this host, so
+    // an external logger (the policy bridge) can join its own records to these rows by time; the
+    // recorder's own pc_time_s is relative to run_start_ns, which nobody outside knows.
+    r.mono_ns = static_cast<std::int64_t>(mon_.cycle_start_ns);
+    // FollowUnit::telemetry() reads private unit state; it is only MEANINGFUL while the unit is the
+    // active task (its members hold the last episode's values otherwise), so gate it on that.
+    if (a.active_task_ == &a.follow_unit_) {
+        r.fol_engaged = 1;
+        // gap_mm wants the EMITTED point in the unit's own working frame (arm base): FK(cmd_.q)
+        // through the arm's own chain (the root-frame tcp_c above carries the mount, so it is not
+        // the same point). One more 6-DoF FK per tick, microseconds, only while Follow is active.
+        Eigen::Matrix<double, 6, 1> qc;
+        for (int j = 0; j < 6; ++j) qc[j] = a.cmd_.q[j];
+        const Eigen::Vector3d emitted_arm = a.kine_.forward(qc).block<3, 1>(0, 3);
+        const FollowUnit::Telemetry ft = a.follow_unit_.telemetry(emitted_arm);
+        for (int c = 0; c < 3; ++c) {
+            r.fol_cmd_p[c] = ft.cmd_p_f[c];  r.fol_ref_p[c] = ft.ref_p_f[c];
+            r.fol_in_v[c]  = ft.in_v[c];     r.fol_in_w[c]  = ft.in_w[c];
+        }
+        {
+            const Eigen::Vector3d cz = ft.cmd_R_f.eulerAngles(2, 1, 0);   // Rz, Ry, Rx [rad]
+            const Eigen::Vector3d rz = ft.ref_R_f.eulerAngles(2, 1, 0);
+            r.fol_cmd_rpy[0] = cz[2] * R2D; r.fol_cmd_rpy[1] = cz[1] * R2D; r.fol_cmd_rpy[2] = cz[0] * R2D;
+            r.fol_ref_rpy[0] = rz[2] * R2D; r.fol_ref_rpy[1] = rz[1] * R2D; r.fol_ref_rpy[2] = rz[0] * R2D;
+        }
+        r.fol_v_cmd = ft.v_cmd;       r.fol_w_cmd = ft.w_cmd;
+        r.fol_lag_mm = ft.lag_mm;     r.fol_lag_deg = ft.lag_deg;   r.fol_gap_mm = ft.gap_mm;
+        r.fol_sigma_min = ft.sigma_min;
+        r.fol_gate_t = ft.gate_t;     r.fol_gate_r = ft.gate_r;
+        r.fol_chunk_stamp_ns = static_cast<std::int64_t>(ft.chunk_stamp_ns);
+        r.fol_chunk_idx = ft.chunk_idx;  r.fol_chunk_n = ft.chunk_n;
+        r.fol_playing = ft.period_playing ? 1 : 0;
+    }
+    r.follow_slot_seq = a.follow_chunk_.seq();
+    // The overlay's live deviation, arm base (m/rad inside -> mm/deg on the row like everything else).
+    {
+        const Eigen::Vector3d& dt = a.task_overlay_.dev_t();
+        const Eigen::Vector3d& dr = a.task_overlay_.dev_r();
+        for (int c = 0; c < 3; ++c) { r.dev_t[c] = dt[c] * 1e3; r.dev_r[c] = dr[c] * R2D; }
+        r.overlay_bounded = a.task_overlay_.bounded() ? 1 : 0;
+    }
+    // External process values: the level at this tick (never acted on - see ExtScalarSlot).
+    {
+        double ev[ExtScalarSlot::kMax]; int en = 0; std::uint64_t es = 0;
+        if (a.ext_slot_.read(ev, en, es)) {
+            for (int c = 0; c < ExtScalarSlot::kMax; ++c) r.ext[c] = ev[c];
+            r.ext_n = en; r.ext_stamp_ns = static_cast<std::int64_t>(es);
+        }
+        r.ext_seq = a.ext_slot_.count();
+    }
     recorder_.push(r);
 }

+// TIMELINE as cmd/act/ref - which only the recorder can provide. So: a latest-value slot of up to
+// kMax named-by-the-publisher doubles + the publisher's stamp, deposited from
+// <side>/cmd/ext_scalars (sensor_msgs/JointState: position[] = the values, header.stamp = when).
+// The RT loop NEVER acts on these; Arm::record_row copies the current level into the row. Level
+// semantics like JogSlot (a value stays until replaced); `count()` = deposits so far, so a reader
+// can tell "unchanged" from "re-sent". Meaning of each index is the PUBLISHER's contract, not
+// this tree's - it is documented where it is published.
+class ExtScalarSlot {
+public:
+    static constexpr int kMax = 8;
+    void set(const double* v, int n, std::uint64_t stamp_ns) {
+        if (n < 0) n = 0;
+        if (n > kMax) n = kMax;
+        const unsigned s = seq_.load(std::memory_order_relaxed);
+        seq_.store(s + 1, std::memory_order_release);   // odd: write in progress
+        for (int i = 0; i < kMax; ++i) val_[i] = (i < n) ? v[i] : 0.0;
+        n_ = n;
+        stamp_ns_ = stamp_ns;
+        seq_.store(s + 2, std::memory_order_release);   // even: write complete
+    }
+    // Consumer (RT): always the current level; false only if never published.
+    bool read(double out[kMax], int& n, std::uint64_t& stamp_ns) const {
+        unsigned s0, s1;
+        double tmp[kMax];
+        int tn;
+        std::uint64_t st;

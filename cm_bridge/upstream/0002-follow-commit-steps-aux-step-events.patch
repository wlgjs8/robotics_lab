+class FollowStepRing {
+public:
+    static constexpr std::uint32_t CAP = 32;    // > 1 s of periods; the drain runs at 250 Hz
+    // RT producer.
+    void push(FollowStepEvent ev) {
+        const std::uint32_t c = count_.load(std::memory_order_relaxed);
+        ev.seq = c + 1;
+        ring_[c % CAP] = ev;
+        count_.store(c + 1, std::memory_order_release);
+    }
+    std::uint32_t count() const { return count_.load(std::memory_order_acquire); }
+    // Consumer: copy event #seq (1-based). False if it is gone (overwritten) or not yet written.
+    bool get(std::uint32_t seq, FollowStepEvent& out) const {
+        const std::uint32_t c = count_.load(std::memory_order_acquire);
+        if (seq == 0 || seq > c || c - seq >= CAP) return false;
+        out = ring_[(seq - 1) % CAP];
+        return out.seq == seq;             // torn by a wrap-around during the copy -> refused
+    }
+private:
+    FollowStepEvent ring_[CAP]{};
+    std::atomic<std::uint32_t> count_{0};
+};

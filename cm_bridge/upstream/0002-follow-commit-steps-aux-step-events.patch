+// chunk so it continues exactly from here) reads it instead of guessing from its own clock.
+struct FollowStepEvent {
+    std::uint64_t mono_ns = 0;        // boundary time (rt::now_ns)
+    std::uint32_t seq = 0;            // event counter (ring bookkeeping)
+    std::int32_t  kind = 0;           // 0 = no delta this period (starved) | 1 = delta started |
+                                      // 2 = delta started AND a fresh chunk was adopted here |
+                                      // 3 = unit exited (silence / stop) - prev_* is the last delta
+    std::uint64_t stamp_ns = 0;       // chunk being played (kind 1/2)
+    std::int32_t  idx = -1;           // delta index that just STARTED (0-based; -1 if none)
+    std::int32_t  n = 0;              // deltas in that chunk
+    double        aux[FollowChunk::kAux]{}; // that delta's aux (NaN if the chunk had none)
+    std::uint64_t prev_stamp_ns = 0;  // the delta that just FINISHED (0 = none)
+    std::int32_t  prev_idx = -1;
+    double        prev_aux[FollowChunk::kAux]{};
+    std::uint32_t slot_seq = 0;       // FollowChunkSlot::seq() at the boundary

<mujoco model="dual_rb3_730e_ver3">

  <compiler angle="radian" meshdir="../meshes" autolimits="true" />

  <option integrator="implicitfast" />

  <default>
    <material specular="0.5" shininess="0.25" />
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" />
    </default>
    <default class="collision">
      <geom type="capsule" group="3" />
    </default>
  </default>

  <default>
    <default class="stand_vis">
      <geom contype="0" conaffinity="0" group="1" density="0" rgba="0.5 0.5 0.66 1" />
    </default>
  </default>

  <asset>
    <mesh name="dual_rb3_730e_stand_ver3" file="stands/dual_rb3_730e/dual_rb3_730e_stand_ver3.stl"
      scale="0.001 0.001 0.001" />
    <mesh name="realsense_d435f" file="../camera/realsense_d435f.obj" />
  </asset>

  <asset>
    <model name="rb3_730e" file="rb3_730e/rb3_730e.xml" />
  </asset>

  <!-- TODO: Use dual_rb3_730e_stand.xml -->
  <worldbody>
    <body name="base" pos="0 0 0">
      <body
        name="stand" pos="0 0 0" euler="0 0 1.57078">
        <geom name="stand_base_vis" type="mesh" mesh="dual_rb3_730e_stand_ver3" pos="0 0 0.01"
          euler="0 0 -1.57078" rgba="0.5 0.5 0.5 1" class="stand_vis" />
        <!-- TODO: Change to Accurate Collision -->
        <body name="stand_base_col" euler="0 0 -1.57078">
          <geom name="stand_body_base_geom" type="box" size="0.12 0.15 0.005"

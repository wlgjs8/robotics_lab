# pgmode-sim (rbpodo controller-simulation) launch env — TEMPLATE.
# Copy to pgmode_sim.env (gitignored) and adjust IPs/ports for your box:
#   cp rb_servo_server/config/local/pgmode_sim.env.example \
#      rb_servo_server/config/local/pgmode_sim.env
#
# CONTROLLER SIMULATION ONLY. Every robot is backend_type=rbpodo,
# run_mode=real, operation_mode=simulation, physical_motion_expected=false.
# RB_ALLOW_REAL_CARTESIAN is NEVER set here and must never be added.
# Sourced by tools/vm/pgmode_sim_up.sh.

# Server config (gitignored local; see vm_dual_cartesian.yaml).
PGMODE_SIM_CONFIG=rb_servo_server/config/local/vm_dual_cartesian.yaml
# rbpodo-enabled server binary (build with: make pgmode-sim-build).
PGMODE_SIM_BIN=rb_servo_server/build_rbpodo/rb_servo_server
# Python with viser + the rbpodo SDK (the repo venv).
PGMODE_SIM_PYTHON=.venv/bin/python

# --- rb_servo_server gates (controller-simulation; NOT physical real) ---
export RB_ALLOW_REAL_ROBOT=1
export RB_ALLOW_REAL_MOTION=1
export RB_ALLOW_RBPODO_CONTROLLER_SIM_MOTION=1
export RB_ALLOW_RBPODO_CONTROLLER_SIM_CARTESIAN=1
export RB_RBPODO_PGMODE_SIMULATION_CONFIRMED=1
# Virtual ControlBox tolerances (pure-software sim controllers):
export RB_ALLOW_RBPODO_DIAGNOSTICS_SUSPECT_CONTROLLER_SIM=1
export RB_ALLOW_RBPODO_NOT_ACTIVATED_CONTROLLER_SIM=1
# ACK-off streaming (the Virtual ControlBox does not ACK reliably at 500 Hz):
export RB_ALLOW_RBPODO_ACK_DISABLED_MOTION=1
# Only needed if the config enables servo.rbpodo_async_streaming (sdk_ack_worker):
export RB_ALLOW_RBPODO_ASYNC_STREAMING=1

# --- rb_gui (viser) ---
# Must match the server's network.command_bind / state_pub_endpoint ports.
export RB_GUI_COMMAND_PORT=50031
export RB_GUI_STATE_PORT=50131
export RB_GUI_PORT=8080
export RB_GUI_OBSERVED_MODE=simulation
export RB_GUI_OBSERVED_BACKEND=rbpodo
export RB_GUI_ENABLE_TCP_POSE_COMMANDS=1
export RB_GUI_ENABLE_CONTROLLER_SIM_CARTESIAN=1
export RB_GUI_CARTESIAN_AVAILABLE=1
export RB_GUI_SIM_READINESS_READY=1

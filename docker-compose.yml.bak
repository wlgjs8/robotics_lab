services:
  rb_gui:
    build:
      context: .
      dockerfile: rb_gui/docker/rb_servo_gui.Dockerfile
    image: robotics_lab/rb_gui:dev
    init: true
    networks:
      rb_servo_net:
        aliases:
          - rb_servo_gui
    environment:
      RB_GUI_HOST: "0.0.0.0"
      RB_GUI_PORT: "8080"
      RB_GUI_STATE_BIND: "0.0.0.0"
      RB_GUI_STATE_PORT: "50110"
      RB_GUI_COMMAND_HOST: "rb_servo_server"
      RB_GUI_COMMAND_PORT: "50010"
      # Observed mode/backend are display-only labels. Readiness and Cartesian
      # availability are derived from the live server state stream (the server is
      # the sole motion authority), so the old GUI env unlocks for readiness,
      # Cartesian, and TCP-pose feature flags are retired — none are needed here.
      RB_GUI_OBSERVED_MODE: "simulation"
      RB_GUI_OBSERVED_BACKEND: "simulator"
      RB_GUI_OPS_AVAILABLE: "0"
      RB_GUI_INIT_LEFT_JOINTS: "-124.660, 32.485, 119.074, -96.294, -81.798, -30.615"
      RB_GUI_INIT_RIGHT_JOINTS: "111.949, -49.304, -120.057, 75.305, 87.436, 49.983"
      RB_GUI_INIT_MOTION_TIMEOUT_SEC: "10.0"
    ports:
      - "127.0.0.1:8080:8080/tcp"
      - "127.0.0.1:50110:50110/udp"

  rb_simulator_left:
    build:
      context: .
      dockerfile: rb_simulator/docker/rb_simulator.Dockerfile
    image: robotics_lab/rb_simulator:dev
    command: ["--config", "rb_simulator/config/left_rb3_730e_compose.yaml"]
    environment:
      RB_SIMULATOR_ALLOW_NON_LOOPBACK: "1"
    init: true
    networks:
      rb_servo_net:
        aliases:
          - rb_simulator_left
          - left_controller_sim
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import socket; s=socket.create_connection(('127.0.0.1', 50200), 1.0); s.close()",
        ]
      interval: 1s
      timeout: 2s
      retries: 10
      start_period: 1s
    labels:
      rb-servo.role: "hardware-free-simulator-left"
      rb-servo.hardware: "none"
      rb-servo.ova: "not-used"

  rb_simulator_right:
    build:
      context: .
      dockerfile: rb_simulator/docker/rb_simulator.Dockerfile
    image: robotics_lab/rb_simulator:dev
    command: ["--config", "rb_simulator/config/right_rb3_730e_compose.yaml"]
    environment:
      RB_SIMULATOR_ALLOW_NON_LOOPBACK: "1"
    init: true
    networks:
      rb_servo_net:
        aliases:
          - rb_simulator_right
          - right_controller_sim
    depends_on:
      rb_simulator_left:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import socket; s=socket.create_connection(('127.0.0.1', 50200), 1.0); s.close()",
        ]
      interval: 1s
      timeout: 2s
      retries: 10
      start_period: 1s
    labels:
      rb-servo.role: "hardware-free-simulator-right"
      rb-servo.hardware: "none"
      rb-servo.ova: "not-used"

  rb_servo_server:
    build:
      context: .
      dockerfile: scripts/docker/rb_servo_server.hardware_free.Dockerfile
      target: runtime
    image: robotics_lab/rb_servo_server:dev
    command: ["--config", "config/dual_simulator_compose.yaml"]
    init: true
    networks:
      rb_servo_net:
        aliases:
          - rb_servo_server
    depends_on:
      rb_gui:
        condition: service_started
      rb_simulator_left:
        condition: service_healthy
      rb_simulator_right:
        condition: service_healthy
    volumes:
      - ./rb_servo_server/logs:/workspace/logs
    labels:
      rb-servo.role: "hardware-free-simulator-servo-server"
      rb-servo.hardware: "none"
      rb-servo.ova: "not-used"

  policy_runner_record:
    build:
      context: .
      dockerfile: policy_runner/docker/policy_runner.Dockerfile
      target: runtime
    image: robotics_lab/policy_runner:dev
    command:
      [
        "record",
        "--state-bind",
        "udp://0.0.0.0:50120",
        "--output-dir",
        "/data/policy_episodes",
      ]
    init: true
    networks:
      rb_servo_net:
        aliases:
          - policy_runner_state_sink
    depends_on:
      rb_servo_server:
        condition: service_started
    volumes:
      - ./policy_runner/episodes:/data/policy_episodes
    labels:
      rb-servo.role: "hardware-free-policy-recorder"
      rb-servo.hardware: "none"

  policy_runner_teleop_record:
    profiles: ["teleop"]
    build:
      context: .
      dockerfile: policy_runner/docker/policy_runner.Dockerfile
      target: runtime
    image: robotics_lab/policy_runner:dev
    command:
      [
        "teleop-record",
        "--config",
        "policy_runner/config/simulator_dual_spacemouse_cartesian_compose.yaml",
        "--output-dir",
        "/data/policy_episodes",
      ]
    init: true
    networks:
      rb_servo_net:
        aliases:
          - policy_runner_state_sink
    depends_on:
      rb_servo_server:
        condition: service_started
    devices:
      - /dev/hidraw1:/dev/hidraw1
      - /dev/hidraw6:/dev/hidraw6
    volumes:
      - ./policy_runner/episodes:/data/policy_episodes
    labels:
      rb-servo.role: "hardware-free-policy-teleop-recorder"
      rb-servo.hardware: "spacemouse"

  policy_train:
    profiles: ["ml"]
    build:
      context: .
      dockerfile: policy_runner/docker/policy_runner.Dockerfile
      target: cuda-ml
    image: robotics_lab/policy_runner:cuda-ml
    command:
      [
        "train",
        "--episodes-dir",
        "/data/policy_episodes",
        "--checkpoint",
        "/data/checkpoints/bc_state_to_twist.pt",
      ]
    init: true
    gpus: all
    networks: [rb_servo_net]
    volumes:
      - ./policy_runner/episodes:/data/policy_episodes:ro
      - ./policy_runner/checkpoints:/data/checkpoints
    labels:
      rb-servo.role: "hardware-free-policy-train"
      rb-servo.hardware: "gpu"

  policy_runner_infer:
    profiles: ["infer"]
    build:
      context: .
      dockerfile: policy_runner/docker/policy_runner.Dockerfile
      target: cuda-ml
    image: robotics_lab/policy_runner:cuda-ml
    command:
      [
        "infer",
        "--config",
        "policy_runner/config/simulator_dual_spacemouse_cartesian_compose.yaml",
        "--checkpoint",
        "/data/checkpoints/bc_state_to_twist.pt",
      ]
    init: true
    gpus: all
    networks:
      rb_servo_net:
        aliases:
          - policy_runner_state_sink
    depends_on:
      rb_servo_server:
        condition: service_started
    volumes:
      - ./policy_runner/checkpoints:/data/checkpoints:ro
    labels:
      rb-servo.role: "hardware-free-policy-infer"
      rb-servo.hardware: "gpu"

  camera_server_mock:
    profiles: ["mock_camera"]
    build:
      context: .
      dockerfile: scripts/docker/camera_server_mock.Dockerfile
    image: robotics_lab/camera_server_mock:dev
    command: ["--config", "/app/config/mock_triple_realsense.yaml", "--simulate"]
    init: true
    ipc: private
    shm_size: "256mb"
    networks: [rb_servo_net]
    volumes:
      - ./camera_server/episodes:/data/episodes
    environment:
      CAMERA_SERVER_CONFIG: /app/config/mock_triple_realsense.yaml
    labels:
      rb-servo.role: "hardware-free-mock-camera"
      rb-servo.hardware: "none"

  camera_server:
    profiles: ["real_camera"]
    build:
      context: ./camera_server
      dockerfile: Dockerfile
    image: robotics_lab/camera_server:dev
    container_name: camera_server
    ipc: host
    shm_size: "2gb"
    network_mode: host
    privileged: true
    devices:
      - /dev/bus/usb:/dev/bus/usb
    volumes:
      - /dev:/dev
      - /run/udev:/run/udev:ro
      - ./camera_server/config:/app/config:ro
      - ./camera_server/episodes:/data/episodes
    environment:
      # Container path; override with CAMERA_CONFIG (see Makefile camera-real-up).
      CAMERA_SERVER_CONFIG: ${CAMERA_CONFIG:-/app/config/triple_realsense.yaml}
    command: ["--config", "${CAMERA_CONFIG:-/app/config/triple_realsense.yaml}"]
    labels:
      rb-servo.role: "real-camera"
      rb-servo.hardware: "realsense"

networks:
  rb_servo_net:
    driver: bridge
